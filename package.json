{
    "name":  "dsh-arya-image-gen",
    "version":  "0.18.4",
    "description":  "ComfyUI-native image generation for DeepSeek Harness: chat tools, creative canvas, Studio workbench, workflow comparison, and built-in server control.",
    "type":  "module",
    "author":  "AryaCode",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/KonnectSuite/dsh-arya-image-gen.git"
                   },
    "bugs":  {
                 "url":  "https://github.com/KonnectSuite/dsh-arya-image-gen/issues"
             },
    "homepage":  "https://github.com/KonnectSuite/dsh-arya-image-gen#readme",
    "main":  "lib/index.js",
    "types":  "lib/types/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./client":  {
                                     "types":  "./lib/types/client/index.d.ts",
                                     "default":  "./lib/client.js"
                                 },
                    "./agent-toolset":  {
                                            "types":  "./lib/types/agent-preset/toolset.d.ts",
                                            "default":  "./lib/agent-toolset.js"
                                        },
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib/index.js",
                  "lib/client.js",
                  "lib/agent-toolset.js",
                  "lib/types/**/*.d.ts",
                  "skills/**/*.md",
                  "assets/fonts/*",
                  "cordis.patch.yml",
                  "README.md",
                  "docs/assets/readme/*.webp",
                  "docs/workflows/*",
                  "LICENSE",
                  "NOTICE"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "inject":  [
                                              "@deepseek-ai/dsh-client-connection",
                                              "@deepseek-ai/dsh-api-remotes",
                                              "@deepseek-ai/dsh-client-ui-conversation",
                                              "@deepseek-ai/dsh-client-ui-settings",
                                              "@deepseek-ai/dsh-client-ui-settings-plugins",
                                              "@deepseek-ai/dsh-client-ui-sidebar-right",
                                              "@deepseek-ai/dsh-client-ui-tool",
                                              "@deepseek-ai/dsh-client-locale"
                                          ],
                               "platform":  "web"
                           }
            },
    "scripts":  {
                    "typecheck":  "tsc --noEmit",
                    "build":  "node scripts/sync-default-workflows.mjs \u0026\u0026 tsc \u0026\u0026 tsdown",
                    "prepare":  "pnpm run build",
                    "test":  "vitest run",
                    "test:package":  "node scripts/check-package.mjs",
                    "pack:check":  "pnpm pack --dry-run",
                    "sync:workflows":  "node scripts/sync-default-workflows.mjs"
                },
    "engines":  {
                    "node":  "^22.19.0 || \u003e=24.0.0",
                    "dsh":  "\u003e=0.1.7 \u003c1"
                },
    "license":  "Apache-2.0",
    "keywords":  [
                     "deepseek",
                     "deepseek-harness",
                     "dsh",
                     "dsh-plugin",
                     "comfyui",
                     "comfyui-workflow",
                     "image-generation",
                     "ai-image-generation",
                     "local-ai",
                     "workflow"
                 ],
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "\u003e=4.0.0 \u003c5",
                             "@deepseek-ai/schemastery":  "\u003e=3.18.4 \u003c4",
                             "react":  "\u003e=18.2.0 \u003c19"
                         },
    "peerDependenciesMeta":  {
                                 "@deepseek-ai/cordis":  {
                                                             "optional":  true
                                                         },
                                 "@deepseek-ai/schemastery":  {
                                                                  "optional":  true
                                                              },
                                 "react":  {
                                               "optional":  true
                                           }
                             },
    "devDependencies":  {
                            "@deepseek-ai/cordis":  "4.0.4",
                            "@deepseek-ai/dsh-agent":  "0.1.7-rc.2",
                            "@deepseek-ai/dsh-api-remotes":  "0.1.7-rc.2",
                            "@deepseek-ai/dsh-attachment":  "0.1.7-rc.2",
                            "@deepseek-ai/dsh-client-connection":  "0.1.7-rc.2",
                            "@deepseek-ai/dsh-client-ui-conversation":  "0.1.7-rc.2",
                            "@deepseek-ai/dsh-client-ui-settings":  "0.1.7-rc.2",
                            "@deepseek-ai/dsh-client-ui-settings-plugins":  "0.1.7-rc.2",
                            "@deepseek-ai/dsh-client-ui-sidebar-right":  "0.1.7-rc.2",
                            "@deepseek-ai/dsh-client-ui-slots":  "0.1.7-rc.2",
                            "@deepseek-ai/dsh-client-ui-tool":  "0.1.7-rc.2",
                            "@deepseek-ai/dsh-credentials":  "0.1.7-rc.2",
                            "@deepseek-ai/dsh-host-webserver":  "0.1.7-rc.2",
                            "@deepseek-ai/dsh-llm":  "0.1.7-rc.2",
                            "@deepseek-ai/dsh-session":  "0.1.7-rc.2",
                            "@deepseek-ai/dsh-settings":  "0.1.7-rc.2",
                            "@deepseek-ai/dsh-tools":  "0.1.7-rc.2",
                            "@deepseek-ai/dsh-workspace":  "0.1.7-rc.2",
                            "@deepseek-ai/schemastery":  "3.18.4",
                            "@types/node":  "^22.20.0",
                            "@types/react":  "~18.3.1",
                            "lucide-react":  "^1.38.0",
                            "react":  "^18.2.0",
                            "react-dom":  "18.3.1",
                            "tldraw":  "5.3.0",
                            "tsdown":  "^0.22.2",
                            "typescript":  "^6.0.3",
                            "unrun":  "^0.3.1",
                            "vitest":  "^4.1.8"
                        },
    "packageManager":  "pnpm@11.7.0"
}
